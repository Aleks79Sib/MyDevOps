{
  "info": {
    "name": "ShopSphere Functional Tests",
    "description": "Functional tests for ShopSphere through Traefik Ingress. Endpoints are based on the actual Spring controllers in the project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('username')) {",
          "  const suffix = Date.now().toString();",
          "  pm.environment.set('username', 'newman_' + suffix);",
          "  pm.environment.set('email', 'newman_' + suffix + '@example.com');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "productId",
      "value": "000000000000000000000000"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public API",
      "item": [
        {
          "name": "GET products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('success=true', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('data is an array', function () { pm.expect(body.data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET active products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "active"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('success=true', function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET products page",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/page?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "page"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST register test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Newman\",\n  \"lastName\": \"Test\",\n  \"phoneNumber\": \"+905551234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('success=true', function () { pm.expect(body.success).to.eql(true); });",
                  "if (body.data && body.data.userId) pm.environment.set('userId', body.data.userId);",
                  "if (body.data && body.data.token) pm.environment.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('success=true', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('JWT token returned', function () { pm.expect(body.data.token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('token', body.data.token);",
                  "pm.environment.set('userId', body.data.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Host",
                "value": "{{host}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "pm.test('success=true', function () { pm.expect(body.success).to.eql(true); });",
                  "pm.test('New JWT token returned', function () { pm.expect(body.data.token).to.be.a('string').and.not.empty; });",
                  "pm.environment.set('token', body.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
