# Сборка бинарника hello_fcgi в контейнере
FROM debian:bookworm-slim AS builder

WORKDIR /build
COPY server/hello.c /build/hello.c

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libfcgi-dev && \
    gcc -o hello_fcgi hello.c -lfcgi && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*


# Запускаем nginx и spawn-fcgi
FROM debian:bookworm-slim

# Ставим ТОЛЬКО то, что нужно для работы
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        nginx \
        spawn-fcgi \
        libfcgi0ldbl \
        curl \
        ca-certificates && \
    # Создаем пользователя
    useradd -m -s /sbin/nologin lorydari && \
    # Настраиваем права для nginx
    mkdir -p /var/cache/nginx && \
    chown -R lorydari:lorydari /var/log/nginx /var/cache/nginx /var/lib/nginx && \
    mkdir -p /app && \
    chown -R lorydari:lorydari /app && \
    # Чистим кэш
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Копируем бинарник и конфиг
COPY --from=builder /build/hello_fcgi /app/hello_fcgi
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Пробрасываем логи в stdout/stderr (best practice для Docker)
# и добавляем пользователя в группу nginx для доступа к логам
RUN usermod -aG adm lorydari && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:81/ || exit 1

USER lorydari

CMD ["sh", "-c", "spawn-fcgi -p 8080 /app/hello_fcgi & nginx -g 'daemon off;'"]